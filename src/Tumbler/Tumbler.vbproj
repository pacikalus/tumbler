<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Tumbler</RootNamespace>
    <AssemblyName>Tumbler</AssemblyName>
    <StartupObject>Tumbler.Program</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Lets the project build on non-Windows machines too (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The version lives in version.txt; every build raises its last number (see RaisePatchVersion). -->
    <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
    <Version>$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <Product>Tumbler</Product>
    <Description>View and edit PDF files: pages, rotation, comments, highlights.</Description>
    <ApplicationIcon>Tumbler.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="Tumbler.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded so the window and taskbar show the same icon as the .exe. -->
    <EmbeddedResource Include="Tumbler.ico" LogicalName="Tumbler.ico" />
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="logo.png" Link="logo.png" />
    <EmbeddedResource Include="..\..\assets\pacikalus.png" LogicalName="pacikalus.png" Link="pacikalus.png" />
    <!-- Toolbar pictures, one strip per size (drawn by tools\make-toolbar-icons.py). -->
    <EmbeddedResource Include="Icons\toolbar-*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tumbler.Core\Tumbler.Core.vbproj" />
  </ItemGroup>

  <!--
    Every build raises the patch number, the last one (1.4.6 -> 1.4.7), saves it back to
    version.txt and stamps the new number into Tumbler.exe. Visual Studio's background
    builds (the ones that only refresh IntelliSense) don't count.
  -->
  <Target Name="RaisePatchVersion" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_OldVersion>$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</_OldVersion>
      <_VersionBase>$([System.Text.RegularExpressions.Regex]::Replace('$(_OldVersion)', '\.\d+$', ''))</_VersionBase>
      <_Patch>$([System.Text.RegularExpressions.Regex]::Match('$(_OldVersion)', '\d+$').Value)</_Patch>
      <Version>$(_VersionBase).$([MSBuild]::Add($(_Patch), 1))</Version>
      <VersionPrefix>$(Version)</VersionPrefix>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Lines="$(Version)" Overwrite="true" />
    <Message Importance="high" Text="Tumbler version $(Version)" />
  </Target>

</Project>
