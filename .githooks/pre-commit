#!/bin/sh
# Raises Tumbler's patch version (the last number) on every commit: 1.1.4 -> 1.1.5.
# Raise the middle number by hand in Tumbler.vbproj for bigger releases.
# Turn it on once per clone with:  git config core.hooksPath .githooks
proj="src/Tumbler/Tumbler.vbproj"
[ -f "$proj" ] || exit 0
current=$(sed -n 's:.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\)</Version>.*:\1:p' "$proj" | head -n 1)
[ -n "$current" ] || { echo "pre-commit: no <Version> in $proj" >&2; exit 1; }
base=${current%.*}
patch=${current##*.}
next="$base.$((patch + 1))"
sed -i.bak "s:<Version>[0-9.]*</Version>:<Version>$next</Version>:" "$proj" && rm -f "$proj.bak"
git add "$proj"
echo "Tumbler version $next"
